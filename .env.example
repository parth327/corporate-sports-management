# ---------------------------------------------------------------------------
# Corporate Sports Events Management — front-end configuration
#
# Copy this file to `.env` (or `.env.local`) and edit. Vite only exposes
# variables prefixed with VITE_ to the browser, so never put a secret here.
# Restart `npm run dev` after changing anything in this file.
# ---------------------------------------------------------------------------

# THE SWITCH.
# true  = serve everything from the seeded in-memory dataset in src/api/mock/
# false = talk to the real ASP.NET Web API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Base URL of the Web API. Leave EMPTY to issue same-origin requests, which is
# what you want when the Vite dev-server proxy is enabled (see vite.config.js)
# or when the built SPA is published into the Web API project itself.
VITE_API_BASE_URL=https://localhost:44301

# Authentication scheme.
#   bearer = OWIN /token endpoint, OAuth password grant  (Web API 4.5 default)
#   cookie = Forms authentication, credentials: 'include'
VITE_AUTH_STRATEGY=bearer

# Set to true ONLY if your Web API returns PascalCase JSON — i.e. you have NOT
# added CamelCasePropertyNamesContractResolver in WebApiConfig.cs.
VITE_NORMALISE_CASING=false

# Artificial latency (ms) applied to mock responses, so loading states are real
# during development. Ignored when VITE_USE_MOCK_API=false.
VITE_MOCK_LATENCY=320
